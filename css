/* ==========================
   DESIGN VARIABLES
========================== */

:root {

  --green: #328b63;
  --green-dark: #246b4b;
  --green-light: #e3f3e9;

  --cream: #fffdf8;
  --soft: #f5f7f2;

  --text: #24342c;
  --text-light: #69766f;

  --border: #e9e7df;

  --radius-sm: 14px;
  --radius-md: 24px;
  --radius-lg: 34px;

  --shadow:
    0 20px 60px rgba(30, 60, 40, 0.1);

  --container:
    1200px;

}


/* ==========================
   RESET
========================== */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}


html {
  scroll-behavior: smooth;
}


body {

  font-family:
    Inter,
    Arial,
    Helvetica,
    sans-serif;

  background:
    var(--cream);

  color:
    var(--text);

  line-height:
    1.6;

}


button,
input {
  font: inherit;
}


button {
  cursor: pointer;
}


a {
  color: inherit;
  text-decoration: none;
}


img {
  max-width: 100%;
}


/* ==========================
   CONTAINER
========================== */

.container {

  width:
    min(
      calc(100% - 40px),
      var(--container)
    );

  margin-inline:
    auto;

}


/* ==========================
   NAV
========================== */

.navbar {

  min-height: 76px;

  padding:
    0 max(20px, 5vw);

  display: flex;

  align-items: center;

  justify-content:
    space-between;

  gap: 20px;

  position: sticky;

  top: 0;

  z-index: 100;

  background:
    rgba(
      255,
      253,
      248,
      0.92
    );

  backdrop-filter:
    blur(15px);

  border-bottom:
    1px solid
    var(--border);

}


.logo {

  font-size:
    1.4rem;

  font-weight:
    800;

  white-space:
    nowrap;

}


.logo span {
  color:
    var(--green);
}


.nav-links {

  display: flex;

  gap:
    clamp(
      16px,
      3vw,
      40px
    );

}


.nav-links a {

  color:
    var(--text-light);

  transition:
    0.2s;

}


.nav-links a:hover {
  color:
    var(--green);
}


/* ==========================
   BUTTONS
========================== */

.button {

  border:
    0;

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  min-height:
    50px;

  padding:
    12px 24px;

  border-radius:
    999px;

  background:
    var(--green);

  color:
    white;

  font-weight:
    700;

  transition:
    transform 0.2s,
    background 0.2s,
    box-shadow 0.2s;

}


.button:hover {

  transform:
    translateY(-2px);

  background:
    var(--green-dark);

  box-shadow:
    0 10px 30px
    rgba(47, 143, 101, 0.18);

}


.button-small {

  min-height:
    42px;

  padding:
    9px 18px;

}


.button-secondary {

  background:
    white;

  color:
    var(--green);

  border:
    2px solid
    #d6eadd;

}


.button-secondary:hover {

  background:
    var(--green-light);

  color:
    var(--green-dark);

}


.button-light {

  background:
    white;

  color:
    var(--green);

}


/* ==========================
   HERO
========================== */

.hero {

  min-height:
    min(780px, 85vh);

  padding-block:
    clamp(
      60px,
      9vw,
      120px
    );

  display:
    grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(300px, 0.85fr);

  gap:
    clamp(
      40px,
      8vw,
      100px
    );

  align-items:
    center;

}


.hero-content {

  max-width:
    680px;

}


.badge {

  display:
    inline-flex;

  padding:
    8px 16px;

  margin-bottom:
    24px;

  border-radius:
    999px;

  background:
    var(--green-light);

  color:
    var(--green-dark);

  font-weight:
    700;

}


.hero h1 {

  font-size:
    clamp(
      3rem,
      7vw,
      5.7rem
    );

  line-height:
    0.98;

  letter-spacing:
    -0.045em;

  margin-bottom:
    25px;

}


.hero h1 span {

  color:
    var(--green);

}


.hero-content > p {

  max-width:
    580px;

  font-size:
    clamp(
      1rem,
      2vw,
      1.18rem
    );

  color:
    var(--text-light);

}


.hero-actions {

  display:
    flex;

  flex-wrap:
    wrap;

  gap:
    12px;

  margin:
    30px 0 25px;

}


.hero-benefits {

  display:
    flex;

  flex-wrap:
    wrap;

  gap:
    10px 24px;

  color:
    var(--text-light);

  font-size:
    0.9rem;

}


/* ==========================
   HERO ART
========================== */

.hero-art {

  position:
    relative;

  width:
    min(100%, 480px);

  aspect-ratio:
    1;

  margin-inline:
    auto;

  display:
    grid;

  place-items:
    center;

}


.hero-circle {

  width:
    68%;

  aspect-ratio:
    1;

  border-radius:
    50%;

  background:
    #ffdd85;

  display:
    grid;

  place-items:
    center;

  font-size:
    clamp(
      6rem,
      12vw,
      10rem
    );

  box-shadow:
    var(--shadow);

  animation:
    floating 4s
    ease-in-out infinite;

}


.floating-pet {

  position:
    absolute;

  width:
    clamp(
      58px,
      7vw,
      82px
    );

  aspect-ratio:
    1;

  display:
    grid;

  place-items:
    center;

  background:
    white;

  border-radius:
    50%;

  font-size:
    clamp(
      2rem,
      5vw,
      2.8rem
    );

  box-shadow:
    0 10px 30px
    rgba(0,0,0,0.1);

}


.floating-one {
  top: 4%;
  left: 5%;
}


.floating-two {
  right: 0;
  top: 21%;
}


.floating-three {
  right: 12%;
  bottom: 0;
}


.floating-four {
  left: 0;
  bottom: 18%;
}


@keyframes floating {

  50% {
    transform:
      translateY(-14px);
  }

}


/* ==========================
   SECTIONS
========================== */

.section {

  padding-block:
    clamp(
      70px,
      9vw,
      120px
    );

}


.section-soft {

  background:
    var(--soft);

}


.section-heading {

  max-width:
    700px;

  text-align:
    center;

  margin:
    0 auto
    clamp(
      35px,
      6vw,
      60px
    );

}


.eyebrow {

  color:
    var(--green);

  font-weight:
    800;

  letter-spacing:
    0.15em;

  font-size:
    0.78rem;

}


.section-heading h2,
.match-copy h2,
.cta h2 {

  font-size:
    clamp(
      2rem,
      5vw,
      3.2rem
    );

  line-height:
    1.1;

  margin:
    10px 0 16px;

}


.section-heading p,
.match-copy p {

  color:
    var(--text-light);

}


/* ==========================
   PET GRID
========================== */

.pet-grid {

  display:
    grid;

  grid-template-columns:
    repeat(
      auto-fit,
      minmax(170px, 1fr)
    );

  gap:
    clamp(
      14px,
      2vw,
      24px
    );

}


.pet-card {

  min-width:
    0;

  padding:
    clamp(
      24px,
      4vw,
      36px
    );

  text-align:
    center;

  background:
    #fffaf0;

  border:
    1px solid
    var(--border);

  border-radius:
    var(--radius-md);

  transition:
    0.25s;

}


.pet-card:hover {

  transform:
    translateY(-7px);

  box-shadow:
    var(--shadow);

  border-color:
    #b7dbc5;

}


.pet-emoji {

  display:
    block;

  font-size:
    clamp(
      3.5rem,
      7vw,
      5rem
    );

  transition:
    0.25s;

}


.pet-card:hover
.pet-emoji {

  transform:
    scale(1.1);

}


.pet-card h3 {

  font-size:
    1.25rem;

  margin-top:
    10px;

}


.pet-card p {

  color:
    var(--text-light);

}


.pet-tag {

  display:
    inline-block;

  margin-top:
    12px;

  padding:
    5px 10px;

  border-radius:
    999px;

  background:
    var(--green-light);

  color:
    var(--green-dark);

  font-size:
    0.75rem;

}


/* ==========================
   STEPS
========================== */

.steps-grid {

  display:
    grid;

  grid-template-columns:
    repeat(
      auto-fit,
      minmax(240px, 1fr)
    );

  gap:
    25px;

}


.step-card {

  padding:
    32px;

  text-align:
    center;

  background:
    white;

  border-radius:
    var(--radius-md);

}


.step-number {

  width:
    32px;

  height:
    32px;

  display:
    grid;

  place-items:
    center;

  margin:
    auto;

  border-radius:
    50%;

  background:
    var(--green);

  color:
    white;

  font-weight:
    800;

}


.step-icon {

  font-size:
    3.2rem;

  margin:
    18px 0;

}


.step-card h3 {

  margin-bottom:
    10px;

}


.step-card p {

  color:
    var(--text-light);

}


/* ==========================
   MATCH
========================== */

.match-layout {

  display:
    grid;

  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );

  gap:
    clamp(
      40px,
      8vw,
      100px
    );

  align-items:
    center;

}


.match-copy {

  max-width:
    500px;

}


.match-copy .button {

  margin-top:
    25px;

}


.example-result {

  position:
    relative;

  width:
    min(100%, 420px);

  margin-inline:
    auto;

  padding:
    clamp(
      28px,
      5vw,
      42px
    );

  text-align:
    center;

  background:
    white;

  border:
    1px solid
    var(--border);

  border-radius:
    var(--radius-lg);

  box-shadow:
    var(--shadow);

}


.match-score {

  position:
    absolute;

  top:
    20px;

  right:
    20px;

  padding:
    6px 10px;

  border-radius:
    999px;

  background:
    var(--green-light);

  color:
    var(--green-dark);

  font-size:
    0.75rem;

  font-weight:
    800;

}


.example-pet {

  font-size:
    clamp(
      6rem,
      14vw,
      9rem
    );

}


.example-result h3 {

  font-size:
    2rem;

}


.result-title {

  color:
    var(--green);

  font-weight:
    700;

  margin-bottom:
    15px;

}


.example-result > p {

  color:
    var(--text-light);

}


.result-stats {

  margin-top:
    25px;

  padding-top:
    15px;

  border-top:
    1px solid
    var(--border);

}


.result-stats div {

  display:
    flex;

  justify-content:
    space-between;

  gap:
    15px;

  padding:
    5px 0;

  font-size:
    0.9rem;

}


.result-stats strong {

  color:
    #e7a72d;

}


/* ==========================
   CTA
========================== */

.cta {

  padding:
    clamp(
      70px,
      9vw,
      110px
    )
    20px;

  text-align:
    center;

  background:
    var(--green);

  color:
    white;

}


.cta-pets {

  font-size:
    clamp(
      2rem,
      7vw,
      4rem
    );

}


.cta p {

  max-width:
    500px;

  margin:
    15px auto 28px;

  color:
    #def0e6;

}


/* ==========================
   FOOTER
========================== */

footer {

  padding:
    32px 0;

  background:
    #173a2c;

  color:
    #dce8e0;

}


.footer-content {

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    20px;

}


/* ==========================
   MODAL
========================== */

.modal {

  position:
    fixed;

  inset:
    0;

  display:
    none;

  align-items:
    center;

  justify-content:
    center;

  padding:
    20px;

  background:
    rgba(10, 25, 18, 0.7);

  backdrop-filter:
    blur(6px);

  z-index:
    500;

}


.modal.active {
  display:
    flex;
}


.quiz {

  position:
    relative;

  width:
    min(100%, 650px);

  max-height:
    calc(100vh - 40px);

  overflow-y:
    auto;

  padding:
    clamp(
      25px,
      6vw,
      45px
    );

  background:
    var(--cream);

  border-radius:
    var(--radius-lg);

}


.close {

  position:
    absolute;

  right:
    16px;

  top:
    16px;

  width:
    40px;

  height:
    40px;

  display:
    grid;

  place-items:
    center;

  border:
    0;

  border-radius:
    50%;

  font-size:
    1.5rem;

  background:
    #eee;

}


.quiz-progress-header {

  display:
    flex;

  justify-content:
    space-between;

  margin-bottom:
    8px;

  color:
    var(--text-light);

  font-size:
    0.85rem;

}


.progress-track {

  height:
    8px;

  overflow:
    hidden;

  background:
    #e1e8e3;

  border-radius:
    999px;

}


.progress-bar {

  width:
    0;

  height:
    100%;

  background:
    var(--green);

  transition:
    width 0.3s;

}


.quiz-icon {

  text-align:
    center;

  font-size:
    4rem;

  margin-top:
    30px;

}


#questionText {

  text-align:
    center;

  margin:
    10px 0 25px;

  font-size:
    clamp(
      1.5rem,
      4vw,
      2rem
    );

}


.answers {

  display:
    grid;

  gap:
    12px;

}


.answer {

  width:
    100%;

  padding:
    16px 18px;

  border:
    2px solid
    #e3e8e4;

  border-radius:
    var(--radius-sm);

  background:
    white;

  color:
    var(--text);

  text-align:
    left;

  transition:
    0.2s;

}


.answer:hover {

  border-color:
    var(--green);

  background:
    var(--green-light);

}


.quiz-result {

  text-align:
    center;

}


.result-emoji {

  font-size:
    clamp(
      6rem,
      20vw,
      10rem
    );

  margin:
    15px 0;

}


.quiz-result h2 {

  font-size:
    clamp(
      2rem,
      6vw,
      3rem
    );

}


.result-percentage {

  display:
    inline-block;

  margin:
    10px 0 20px;

  padding:
    7px 14px;

  border-radius:
    999px;

  background:
    var(--green-light);

  color:
    var(--green-dark);

  font-weight:
    800;

}


.quiz-result > p {

  max-width:
    480px;

  margin:
    0 auto 25px;

  color:
    var(--text-light);

}


.quiz-result-buttons {

  display:
    flex;

  justify-content:
    center;

  flex-wrap:
    wrap;

  gap:
    10px;

}


.hidden {
  display:
    none !important;
}


/* ==========================
   TABLET
========================== */

@media (max-width: 850px) {

  .nav-links {
    display:
      none;
  }


  .hero {

    grid-template-columns:
      1fr;

    text-align:
      center;

  }


  .hero-content {
    margin:
      auto;
  }


  .hero-actions,
  .hero-benefits {

    justify-content:
      center;

  }


  .hero-art {

    max-width:
      400px;

  }


  .match-layout {

    grid-template-columns:
      1fr;

    text-align:
      center;

  }


  .match-copy {

    margin:
      auto;

  }

}


/* ==========================
   MOBILE
========================== */

@media (max-width: 520px) {

  .container {

    width:
      min(
        calc(100% - 28px),
        var(--container)
      );

  }


  .navbar {

    padding:
      0 14px;

  }


  .logo {

    font-size:
      1.15rem;

  }


  .navbar .button {

    font-size:
      0.82rem;

    padding:
      8px 13px;

  }


  .hero {

    padding-top:
      50px;

  }


  .hero-actions {

    display:
      grid;

  }


  .hero-actions .button {

    width:
      100%;

  }


  .pet-grid {

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

  }


  .pet-card {

    padding:
      20px 10px;

  }


  .footer-content {

    flex-direction:
      column;

    text-align:
      center;

  }


  .result-stats div {

    flex-direction:
      column;

    gap:
      0;

  }

}


/* ==========================
   VERY SMALL PHONES
========================== */

@media (max-width: 350px) {

  .pet-grid {
    grid-template-columns:
      1fr;
  }

}
